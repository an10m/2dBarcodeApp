{
  // Pharmacy portal + API. Always use `--config wrangler.pharmacy.jsonc`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2dbarcodeapp-pharmacy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist-pharmacy",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; everything else is served as static files.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "signalcode",
      "database_id": "1d31865e-ac05-4305-bff7-4e2248260949"
    }
  ]
}
